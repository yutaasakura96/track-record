.DS_Store

# Secrets — never commit, regardless of stack
.env
.env.*
!.env.example

# Reference material: real career data, kept on disk for agents, never committed.
# Contains personal PII (home address, phone, DOB), NDA-bound client material,
# named third-party individuals, and internal network addresses.
# Pattern is `local/*`, not `local/`: git does not descend into an excluded
# directory, so the README negation below only works if the contents are
# excluded rather than the directory itself.
local/*
!local/README.md

# Build + tooling
node_modules/
dist/
.wrangler/
*.tsbuildinfo

# Local secrets for `wrangler dev` — the local counterpart of Workers secrets.
# Holds DATABASE_URL, ANTHROPIC_API_KEY, BETTER_AUTH_SECRET, GOOGLE_CLIENT_*.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Never commit a database dump. This repo is public.
*.dump
*.sql.gz
